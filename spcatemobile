<style>
@import url('https://fonts.googleapis.com/css2?family=Fahkwang:wght@400;700&family=DM+Sans:wght@400;500;600;700&display=swap');

.cgs-root,.cgs-root *{box-sizing:border-box;margin:0;padding:0}
.cgs-root{font-family:'DM Sans',sans-serif;padding:32px 24px;position:relative;overflow:hidden}
.cgs-inner{max-width:1280px;margin:0 auto;position:relative}

/* ===== Layout 2 cột ===== */
.cgs-layout{display:flex;gap:24px;align-items:flex-start}
.cgs-sidebar{width:240px;flex-shrink:0;position:sticky;top:0}
.cgs-main{flex:1;min-width:0}

/* ===== Filter sidebar ===== */
.cgs-filter-panel{border-radius:22px;background:rgba(255,255,255,0.5);backdrop-filter:blur(18px) saturate(140%);-webkit-backdrop-filter:blur(18px) saturate(140%);border:1px solid rgba(255,255,255,0.6);padding:13px 18px 18px}
.cgs-filter-title{font-size:16px;font-weight:700;color:#2c1a12;margin-bottom:14px;font-family:'Fahkwang',sans-serif;display:flex;align-items:center;gap:8px}
.cgs-filter-title i{font-size:18px;color:#ee4d2d}

.cgs-filter-list{display:flex;flex-direction:column;gap:6px}
.cgs-chip{display:flex;align-items:center;gap:9px;padding:10px 12px;border-radius:12px;background:transparent;border:1px solid transparent;font-size:13.5px;font-weight:500;color:#4a352c;cursor:pointer;transition:.2s;white-space:nowrap}
.cgs-chip:hover{background:rgba(255,255,255,0.6)}
.cgs-chip i:first-child{font-size:16px;color:#8a6a5c;flex-shrink:0}
.cgs-chip.cgs-chip-main{background:rgba(238,77,45,0.1);border-color:rgba(238,77,45,0.35);color:#ee4d2d}
.cgs-chip.cgs-chip-main i{color:#ee4d2d}
.cgs-chip .ti-chevron-down{font-size:13px;opacity:.5;margin-left:auto}
.cgs-filter-divider{height:1px;background:rgba(0,0,0,0.07);margin:10px 2px}

/* ===== Search ===== */
.cgs-search-wrap{position:relative;display:flex;align-items:center;margin-bottom:18px}
.cgs-search-icon{position:absolute;left:18px;font-size:18px;color:#a07060;pointer-events:none}
.cgs-search-input{width:100%;padding:13px 44px;border-radius:100px;background:rgba(255,255,255,0.55);backdrop-filter:blur(18px) saturate(140%);-webkit-backdrop-filter:blur(18px) saturate(140%);border:1px solid rgba(255,255,255,0.65);font-size:14px;font-family:'DM Sans',sans-serif;color:#2c1a12;outline:none;transition:.2s}
.cgs-search-input::placeholder{color:#a8887c}
.cgs-search-input:focus{background:rgba(255,255,255,0.7);border-color:rgba(238,77,45,0.4)}
.cgs-search-clear{position:absolute;right:16px;font-size:16px;color:#a07060;cursor:pointer;opacity:0;pointer-events:none;transition:.2s}
.cgs-search-clear.cgs-show-clear{opacity:1;pointer-events:auto}
.cgs-search-clear:hover{color:#ee4d2d}
.cgs-search-empty{display:flex;align-items:center;gap:8px;justify-content:center;padding:30px 0;color:#a07060;font-size:14px}
.cgs-search-empty i{font-size:20px}

/* ===== Sort row ===== */
.cgs-sort-bar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;margin-bottom:20px}
.cgs-sort-title{font-size:18px;font-weight:700;color:#2c1a12;font-family:'Fahkwang',sans-serif}
.cgs-sort-opts{display:flex;flex-wrap:wrap;gap:10px}
.cgs-sort-chip{display:flex;align-items:center;gap:6px;padding:9px 16px;border-radius:100px;background:rgba(255,255,255,0.5);backdrop-filter:blur(14px) saturate(140%);-webkit-backdrop-filter:blur(14px) saturate(140%);border:1px solid rgba(255,255,255,0.65);font-size:13.5px;font-weight:500;color:#4a352c;cursor:pointer;transition:.2s;white-space:nowrap}
.cgs-sort-chip:hover{background:rgba(255,255,255,0.7)}
.cgs-sort-chip.active{border-color:#ee4d2d;background:rgba(238,77,45,0.1);color:#ee4d2d}
.cgs-sort-chip i{font-size:15px}

/* ===== Grid ===== */
.cgs-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}

.cgs-card{border-radius:22px;overflow:hidden;background:rgba(255,255,255,0.55);backdrop-filter:blur(18px) saturate(140%);-webkit-backdrop-filter:blur(18px) saturate(140%);border:1px solid rgba(255,255,255,0.6);display:flex;flex-direction:column;transition:transform .2s,opacity .35s,max-height .4s;opacity:0;transform:translateY(10px)}
.cgs-card.cgs-show{opacity:1;transform:translateY(0)}
.cgs-card:hover{transform:translateY(-3px)}

.cgs-img-wrap{width:100%;aspect-ratio:1/1;overflow:hidden;position:relative}
.cgs-img-wrap img{width:100%;height:100%;object-fit:cover;display:block;pointer-events:none}
.cgs-badge{position:absolute;top:10px;left:10px;background:linear-gradient(135deg,#f53d2d,#f63);color:#fff;font-size:10.5px;font-weight:700;padding:4px 10px;border-radius:100px;letter-spacing:.2px}

.cgs-body{padding:13px 13px 15px;display:flex;flex-direction:column;gap:6px;flex:1}
.cgs-title{font-size:13.5px;font-weight:600;color:#2c1a12;line-height:1.4;min-height:38px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.cgs-price-row{display:flex;align-items:baseline;gap:6px;flex-wrap:wrap;margin-top:auto}
.cgs-price-now{font-size:16.5px;font-weight:800;color:#ee4d2d;font-family:'Fahkwang',sans-serif}
.cgs-price-old{font-size:11.5px;color:rgba(0,0,0,0.32);text-decoration:line-through}
.cgs-discount{font-size:11px;font-weight:700;color:#ee4d2d;background:rgba(238,77,45,0.1);padding:1px 6px;border-radius:6px}

/* ===== Load more ===== */
.cgs-more-wrap{display:flex;justify-content:center;margin-top:30px}
.cgs-btn-more{display:flex;align-items:center;gap:8px;padding:13px 34px;border-radius:100px;font-weight:700;font-size:13.5px;font-family:'Fahkwang',sans-serif;cursor:pointer;border:1px solid rgba(238,77,45,0.4);background:rgba(255,255,255,0.5);backdrop-filter:blur(14px) saturate(140%);-webkit-backdrop-filter:blur(14px) saturate(140%);color:#ee4d2d;transition:.25s}
.cgs-btn-more:hover{background:rgba(238,77,45,0.08);transform:translateY(-1px)}
.cgs-btn-more i{font-size:16px;transition:transform .3s}
.cgs-btn-more.cgs-loaded i{transform:rotate(180deg)}

.cgs-hidden{display:none}

@media(max-width:1280px){
  .cgs-grid{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:1080px){
  .cgs-grid{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:900px){
  .cgs-layout{flex-direction:column}
  .cgs-sidebar{width:100%;position:static}

  .cgs-filter-panel{padding:13px 0 16px}
  .cgs-filter-title{padding:0 18px}
  .cgs-filter-divider{display:none}

  .cgs-filter-list{
    flex-direction:row;
    flex-wrap:nowrap;
    overflow-x:auto;
    overflow-y:hidden;
    gap:8px;
    padding:0 18px 14px;
    scroll-snap-type:x proximity;
    -webkit-overflow-scrolling:touch;
    scrollbar-width:thin;
    scrollbar-color:#ee4d2d rgba(0,0,0,0.06);
  }
  .cgs-filter-list::-webkit-scrollbar{height:4px}
  .cgs-filter-list::-webkit-scrollbar-track{background:rgba(0,0,0,0.06);border-radius:10px}
  .cgs-filter-list::-webkit-scrollbar-thumb{background:#ee4d2d;border-radius:10px}

  .cgs-chip{flex:0 0 auto;scroll-snap-align:start}
  .cgs-grid{grid-template-columns:repeat(3,1fr)}
}
@media(max-width:640px){
  .cgs-grid{grid-template-columns:repeat(2,1fr)}
  .cgs-sort-bar{flex-direction:column;align-items:flex-start}
}
</style>

