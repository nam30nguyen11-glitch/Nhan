/* ═══ COSMETIC SHELF ═══ */
.cosmetic-shelf-zone { overflow:hidden; border-radius:32px; padding:0!important }
.cosmetic-shelf-wrap {
  position:relative; width:100%; height:100%;
  background:linear-gradient(145deg,rgba(227,245,239,0.55),rgba(244,252,248,0.25));
  backdrop-filter:blur(24px);
  border:1px solid rgba(255,255,255,0.65);
  border-radius:32px;
  overflow:hidden;
  display:flex; flex-direction:column; justify-content:center;
  gap:12px; padding:20px 20px 14px;
  box-shadow:0 20px 60px rgba(45,122,96,0.07),inset 0 2px 4px rgba(255,255,255,0.6)
}
.cs-glow {
  position:absolute; width:300px; height:300px;
  top:-60px; right:-60px; border-radius:50%;
  background:radial-gradient(circle,rgba(130,210,185,0.3),transparent 70%);
  filter:blur(50px); pointer-events:none
}
.cs-header {
  display:flex; align-items:center; gap:10px; margin-bottom:4px
}
.cs-header-dot {
  width:5px; height:5px; border-radius:50%;
  background:linear-gradient(135deg,#82d2b9,#2d7a60); flex-shrink:0
}
.cs-header-txt {
  font-size:9px; font-weight:700; letter-spacing:3px;
  text-transform:uppercase; color:#2d7a60; opacity:0.7
}
.cs-shelf-row { position:relative; padding-bottom:10px }
.cs-shelf-line {
  position:absolute; bottom:0; left:-24px; right:-24px;
  height:2px;
  background:linear-gradient(90deg,transparent,rgba(130,210,185,0.35) 20%,rgba(130,210,185,0.6) 50%,rgba(130,210,185,0.35) 80%,transparent);
  border-radius:2px;
  box-shadow:0 1px 6px rgba(82,185,148,0.15)
}
.cs-items {
  display:flex; gap:10px; align-items:flex-end; justify-content:center
}
.cs-item {
  display:flex; flex-direction:column; align-items:center; gap:6px;
  cursor:default;
  transition:transform 0.38s cubic-bezier(0.16,1,0.3,1)
}
.cs-item:hover { transform:translateY(-12px) }
.cs-item:hover .cs-img-wrap { box-shadow:0 16px 36px rgba(45,122,96,0.18); }
.cs-img-wrap {
  border-radius:16px; overflow:hidden;
  border:2.5px solid rgba(255,255,255,0.88);
  box-shadow:0 6px 18px rgba(45,122,96,0.1),inset 0 1px 2px rgba(255,255,255,0.9);
  flex-shrink:0; width:95px;
  transition:box-shadow 0.38s cubic-bezier(0.16,1,0.3,1)
}
.cs-img-tall   { height:148px }
.cs-img-medium { height:120px }
.cs-img-short  { height:96px }
.cs-img-wrap img {
  width:100%; height:100%; object-fit:cover; object-position:center top;
  display:block; transition:transform 0.5s cubic-bezier(0.16,1,0.3,1)
}
.cs-item:hover .cs-img-wrap img { transform:scale(1.07) }
.cs-item-info {
  display:flex; flex-direction:column; align-items:center; gap:2px
}
.cs-item-name {
  font-size:8.5px; font-weight:600; color:var(--ink);
  text-align:center; letter-spacing:0.2px; white-space:nowrap
}
.cs-rating { font-size:8px; color:#82d2b9; letter-spacing:1px }
.cs-verdict {
  font-size:7px; font-weight:700; letter-spacing:1.2px;
  text-transform:uppercase; padding:2px 8px; border-radius:20px
}
.cs-verdict-love { background:rgba(130,210,185,0.25); color:#1a6048 }
.cs-verdict-skip { background:rgba(220,180,180,0.25); color:#9a4040 }
.cs-verdict-try  { background:rgba(252,214,140,0.3);  color:#8a6020 }
.cs-footer {
  text-align:right; font-size:8px; font-weight:700;
  letter-spacing:2.5px; text-transform:uppercase;
  color:#2d7a60; opacity:0.45; margin-top:4px
}

/* ═══ FASHION CAROUSEL ═══ */
.fashion-carousel-zone{overflow:hidden;border-radius:32px;padding:0!important}
.fashion-carousel-wrap{
  position:relative;width:100%;height:100%;
  background:linear-gradient(145deg,rgba(236,232,252,0.38),rgba(248,246,255,0.2));
  backdrop-filter:blur(20px);
  border:1px solid rgba(255,255,255,0.6);
  border-radius:32px;
  overflow:hidden;
  display:flex;flex-direction:column;justify-content:center;gap:12px;padding:20px 0;
  box-shadow:0 20px 60px rgba(107,90,191,0.08),inset 0 2px 4px rgba(255,255,255,0.5)
