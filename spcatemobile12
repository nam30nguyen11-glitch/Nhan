<script>
(function(){
  const items = document.querySelectorAll('.nav-item');
  const MEGA_W = 460;
  let closeTimer;
  function positionMega(item){
    const mega = item.querySelector('.mega');
    if(!mega) return;
    const rect = item.getBoundingClientRect();
    const hdrRect = document.getElementById('hdr').getBoundingClientRect();
    let top = hdrRect.bottom + 10;
    let left = rect.left + rect.width/2 - MEGA_W/2;
    const vw = window.innerWidth;
    if(left < 12) left = 12;
    if(left + MEGA_W > vw - 12) left = vw - MEGA_W - 12;
    mega.style.top = top + 'px';
    mega.style.left = left + 'px';
  }
  function openItem(item){
    clearTimeout(closeTimer);
    items.forEach(i => i.classList.remove('open'));
    positionMega(item);
    item.classList.add('open');
  }
  function scheduleClose(item){
    closeTimer = setTimeout(() => item.classList.remove('open'), 100);
  }
  items.forEach(item => {
    item.addEventListener('mouseenter', () => openItem(item));
    item.addEventListener('mouseleave', () => scheduleClose(item));
    const mega = item.querySelector('.mega');
    if(mega){
      mega.addEventListener('mouseenter', () => clearTimeout(closeTimer));
      mega.addEventListener('mouseleave', () => scheduleClose(item));
    }
  });
})();
</script>
