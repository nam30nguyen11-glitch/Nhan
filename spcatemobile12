<script>
(function(){
  const grid=document.getElementById('cgsGrid');
  const moreBtn=document.getElementById('cgsMoreBtn');
  const moreText=document.getElementById('cgsMoreText');
  const moreWrap=document.querySelector('.cgs-more-wrap');
  const searchInput=document.getElementById('cgsSearchInput');
  const searchClear=document.getElementById('cgsSearchClear');
  const searchEmpty=document.getElementById('cgsSearchEmpty');
  const INITIAL_COUNT=12;
  let expanded=false;
  let searching=false;

  function revealVisible(){
    grid.querySelectorAll('.cgs-card:not(.cgs-hidden)').forEach((c,i)=>{
      setTimeout(()=>c.classList.add('cgs-show'),i*25);
    });
  }
  revealVisible();

  moreBtn.addEventListener('click',function(){
    if(!expanded){
      const hidden=grid.querySelectorAll('.cgs-card.cgs-hidden');
      hidden.forEach((c,i)=>{
        c.classList.remove('cgs-hidden');
        setTimeout(()=>c.classList.add('cgs-show'),i*30);
      });
      moreText.textContent='Thu gọn';
      moreBtn.classList.add('cgs-loaded');
      expanded=true;
    }else{
      grid.querySelectorAll('.cgs-card').forEach((c,i)=>{
        if(i>=INITIAL_COUNT){c.classList.remove('cgs-show');c.classList.add('cgs-hidden')}
      });
      moreText.textContent='Xem thêm sản phẩm';
      moreBtn.classList.remove('cgs-loaded');
      expanded=false;
      grid.scrollIntoView({behavior:'smooth',block:'nearest'});
    }
  });

  function sortCards(key){
    const cards=Array.from(grid.querySelectorAll('.cgs-card'));
    cards.sort((a,b)=>{
      if(key==='asc')return (+a.dataset.price)-(+b.dataset.price);
      if(key==='desc')return (+b.dataset.price)-(+a.dataset.price);
      if(key==='promo')return (+b.dataset.discount)-(+a.dataset.discount);
      return (+b.dataset.popular)-(+a.dataset.popular);
    });
    cards.forEach(c=>grid.appendChild(c));
  }

  document.querySelectorAll('.cgs-sort-chip').forEach(chip=>{
    chip.addEventListener('click',function(){
      document.querySelectorAll('.cgs-sort-chip').forEach(c=>c.classList.remove('active'));
      chip.classList.add('active');
      sortCards(chip.dataset.sort);
    });
  });

  function normalize(str){
    return str.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');
  }

  function runSearch(){
    const q=normalize(searchInput.value.trim());
    searchClear.classList.toggle('cgs-show-clear',q.length>0);

    if(q.length===0){
      searching=false;
      grid.querySelectorAll('.cgs-card').forEach((c,i)=>{
        c.style.display='';
        if(i<INITIAL_COUNT||expanded){c.classList.remove('cgs-hidden');c.classList.add('cgs-show')}
        else{c.classList.add('cgs-hidden');c.classList.remove('cgs-show')}
      });
      moreWrap.style.display='';
      searchEmpty.classList.add('cgs-hidden');
      return;
    }

    searching=true;
    let visibleCount=0;
    grid.querySelectorAll('.cgs-card').forEach(c=>{
      const title=normalize(c.querySelector('.cgs-title').textContent);
      const match=title.includes(q);
      c.classList.remove('cgs-hidden');
      c.style.display=match?'':'none';
      if(match){c.classList.add('cgs-show');visibleCount++}
    });
    moreWrap.style.display='none';
    searchEmpty.classList.toggle('cgs-hidden',visibleCount>0);
  }

  searchInput.addEventListener('input',runSearch);
  searchClear.addEventListener('click',function(){
    searchInput.value='';
    runSearch();
    searchInput.focus();
  });
})();
</script>





































