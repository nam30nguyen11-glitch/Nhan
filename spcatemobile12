.fashion-carousel-wrap::before,.fashion-carousel-wrap::after{
  content:'';position:absolute;top:0;bottom:0;width:80px;z-index:10;pointer-events:none
}
.fashion-carousel-wrap::before{left:0;background:linear-gradient(90deg,rgba(248,246,255,0.85),transparent)}
.fashion-carousel-wrap::after{right:0;background:linear-gradient(-90deg,rgba(248,246,255,0.85),transparent)}
.fashion-track{overflow:hidden;width:100%}
.fashion-track-inner{
  display:flex;gap:10px;
