/* Nhúng font chữ trực tiếp */
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,600&family=DM+Sans:wght@400;600&display=swap');

/* 1. Cách ly tuyệt đối: Reset toàn bộ thuộc tính kế thừa từ bên ngoài */
.dt2-isolation, .dt2-isolation * {
  all: initial; /* Xóa bỏ 100% CSS global áp dụng lên vùng này */
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  text-shadow: none;
  box-shadow: none;
  border: none;
  background: transparent;
}

/* 2. Thiết lập lại môi trường hiển thị chuẩn cho container */
.dt2-isolation {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  padding: 0;
  background: transparent;
}

.dt2-stage {
  display: inline-block;
  position: relative;
  padding: 0;
}

/* 3. Khôi phục và định hình text */
.dt2-title {
  display: block;
  margin: 0;
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-weight: 600;
  font-size: clamp(3rem, 9vw, 7rem);
  line-height: 1.15;
  letter-spacing: 0.4px;
  text-align: center;
  position: relative;
  background: linear-gradient(165deg, #f1e6fb 0%, #d9c2f0 18%, #b89be0 38%, #8f7bc9 58%, #6f63ab 78%, #564f86 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  z-index: 2;
}

/* Viền glass mỏng quanh nét chữ */
.dt2-title::after {
  content: 'DƯỠNG DA';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-weight: 600;
  font-size: clamp(3rem, 9vw, 7rem);
  line-height: 1.15;
  letter-spacing: 0.4px;
  text-align: center;
  -webkit-text-fill-color: transparent;
  -webkit-text-stroke: 0.6px rgba(86, 79, 134, 0.4);
  pointer-events: none;
  z-index: 3;
}

/* Bóng mờ tạo độ sâu phía sau chữ */
.dt2-title::before {
  content: 'DƯỠNG DA';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  font-family: 'Cormorant Garamond', serif;
  font-style: italic;
  font-weight: 600;
  font-size: clamp(3rem, 9vw, 7rem);
  line-height: 1.15;
  letter-spacing: 0.4px;
  text-align: center;
  color: #7a6fae;
  transform: translate(0, 3px);
  z-index: 1;
  filter: blur(8px);
  opacity: 0.22;
  pointer-events: none;
}

/* Hiệu ứng bong bóng thủy tinh */
.dt2-bubble {
  display: block;
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.15) 38%, rgba(255, 255, 255, 0) 70%);
