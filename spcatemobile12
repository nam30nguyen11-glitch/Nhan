}
.tt-frame {
  position:absolute;inset:0;width:100%;height:100%;
  border:none;display:block;opacity:0;transition:opacity 0.35s ease
}
.tt-frame.loaded { opacity:1 }
.tt-skeleton {
  position:absolute;inset:0;
  background:linear-gradient(135deg,#1a0a00 0%,#2a1500 50%,#1a0a00 100%);
  background-size:200% 200%;
  animation:shimmer 1.8s ease infinite;
  display:flex;align-items:center;justify-content:center
}
.tt-skeleton-logo {
  width:34px;height:34px;border-radius:9px;
  background:linear-gradient(135deg,#ff0050,#00f2ea);opacity:0.45
}
@keyframes shimmer {
  0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}
}
.tt-dual-dots {display:flex;gap:28px;align-items:center;justify-content:center}
.tt-dual-dot-group {display:flex;align-items:center;gap:6px}
.tt-dual-dot-group-label {font-size:8px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:#b07030;opacity:0.5}
.tt-dot {width:6px;height:6px;border-radius:50%;background:rgba(176,112,48,0.22);transition:all 0.3s cubic-bezier(0.16,1,0.3,1);cursor:pointer}
.tt-dot.active {width:18px;border-radius:4px;background:linear-gradient(90deg,#fcbe78,#b07030)}
.tt-dual-nav {display:flex;gap:10px;align-items:center}
.tt-btn {
  width:36px;height:36px;border-radius:50%;
  background:rgba(255,255,255,0.82);backdrop-filter:blur(12px);
  border:1.5px solid rgba(252,190,120,0.6);
  display:flex;align-items:center;justify-content:center;cursor:pointer;
  transition:background 0.25s,transform 0.25s,box-shadow 0.25s;
  box-shadow:0 4px 14px rgba(176,112,48,0.14)
}
.tt-btn:hover {background:rgba(252,190,120,0.3);transform:scale(1.1);box-shadow:0 8px 22px rgba(176,112,48,0.22)}
.tt-btn:disabled {opacity:0.28;cursor:default;pointer-events:none}
