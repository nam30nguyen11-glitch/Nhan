  pointer-events: none;
  z-index: 0;
  animation: dt2Float 6s ease-in-out infinite;
}

.dt2-bubble.b1 { width: 46px; height: 46px; left: 2%; top: 8%; animation-delay: 0s; }
.dt2-bubble.b2 { width: 26px; height: 26px; right: 6%; top: 18%; animation-delay: 1.1s; }
