.dt2-bubble.b4 { width: 32px; height: 32px; right: 1%; bottom: 2%; animation-delay: 0.6s; }

@keyframes dt2Float {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.55; }
  50% { transform: translateY(-10px) scale(1.06); opacity: 0.85; }
}

/* Sóng ánh sáng lan tỏa phía dưới */
.dt2-glow {
  display: block;
  width: 50%;
  height: 10px;
  margin: 14px auto 0;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(143, 123, 201, 0.45) 0%, rgba(143, 123, 201, 0) 75%);
  filter: blur(3px);
  animation: dt2Pulse 3.2s ease-in-out infinite;
}

@keyframes dt2Pulse {
  0%, 100% { opacity: 0.5; transform: scaleX(0.85); }
  50% { opacity: 1; transform: scaleX(1.05); }
}
</style>
