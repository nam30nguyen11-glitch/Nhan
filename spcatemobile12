.problems-section{padding:0px;position:relative;overflow:hidden}
.ambient-orb{position:absolute;border-radius:50%;filter:blur(100px);pointer-events:none;animation:orbFloat 14s ease-in-out infinite}
.prob-orb-1{width:600px;height:600px;top:-100px;left:-200px;background:radial-gradient(circle,rgba(249,168,176,0.18),transparent 70%)}
.prob-orb-2{width:700px;height:700px;bottom:-150px;right:-200px;background:radial-gradient(circle,rgba(184,168,252,0.18),transparent 70%);animation-delay:-7s}
.prob-orb-3{width:500px;height:500px;top:40%;left:40%;background:radial-gradient(circle,rgba(150,230,205,0.12),transparent 70%);animation-delay:-3.5s}
@keyframes orbFloat{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(30px,-20px) scale(1.05)}66%{transform:translate(-20px,30px) scale(0.97)}}

.prob-section-head{text-align:center;padding:0 40px;margin-bottom:80px;position:relative;z-index:2}
.prob-eyebrow{display:inline-block;font-size:10px;letter-spacing:4px;text-transform:uppercase;font-weight:600;color:var(--muted);margin-bottom:18px;padding:6px 18px;background:linear-gradient(135deg,var(--mint-tint),var(--sky-tint));border-radius:50px}
.prob-section-title{font-family:'Cormorant Garamond',serif;font-size:clamp(30px,3.2vw,46px);font-weight:600;line-height:1.22;margin-bottom:14px;color:var(--ink)}
.prob-section-title em{font-style:italic;font-weight:400}
.prob-section-desc{font-size:13.5px;color:var(--muted);line-height:1.85;max-width:520px;margin:0 auto;font-weight:300}

.prob-container{max-width:1360px;margin:0 auto;padding:0 32px;display:flex;flex-direction:column;gap:120px;position:relative;z-index:2}

/* Chic row */
.chic-row{display:grid;grid-template-columns:1.1fr 0.9fr;gap:80px;align-items:center;position:relative}
.chic-row.reverse{grid-template-columns:0.9fr 1.1fr}
.chic-row.reverse .image-art-zone{order:2}
.chic-row.reverse .text-art-zone{order:1}

/* tiktok row: let height be natural, align tops */
.chic-row.reverse.cr-peach { align-items:start }

.image-art-zone{position:relative;width:100%;height:520px}
.art-glass-plate{
  position:absolute;width:82%;height:82%;top:50%;left:50%;transform:translate(-50%,-50%);
  border-radius:36px;background:rgba(255,255,255,0.28);backdrop-filter:blur(22px) saturate(130%);
  border:1px solid rgba(255,255,255,0.55);border-top:1px solid rgba(255,255,255,0.8);
  box-shadow:0 20px 60px rgba(13,31,26,0.04),inset 0 2px 4px rgba(255,255,255,0.5);
  z-index:1;transition:transform 0.6s cubic-bezier(0.16,1,0.3,1)
}
.chic-row:hover .art-glass-plate{transform:translate(-50%,-50%) scale(1.02)}
.art-img-master{
  position:absolute;width:62%;height:78%;top:6%;left:4%;z-index:3;
  border-radius:24px;overflow:hidden;
  border:4px solid rgba(255,255,255,0.9);box-shadow:0 24px 52px rgba(13,31,26,0.1);
  transition:transform 0.7s cubic-bezier(0.16,1,0.3,1),box-shadow 0.7s
}
.chic-row:hover .art-img-master{transform:translateY(-10px) rotate(-1deg);box-shadow:0 36px 70px rgba(13,31,26,0.14)}
.art-img-mood{
  position:absolute;width:46%;height:52%;bottom:-4%;right:1%;z-index:5;
  border-radius:20px;overflow:hidden;
  border:4px solid rgba(255,255,255,0.95);box-shadow:0 28px 56px rgba(13,31,26,0.12);
  transition:transform 0.7s cubic-bezier(0.16,1,0.3,1) 0.05s,box-shadow 0.7s
}
.chic-row:hover .art-img-mood{transform:translateY(-18px) scale(1.03) rotate(2deg);box-shadow:0 40px 72px rgba(13,31,26,0.18)}
.art-img-master img,.art-img-mood img{width:100%;height:100%;object-fit:cover;transition:transform 1s cubic-bezier(0.25,1,0.5,1)}
.chic-row:hover .art-img-master img,.chic-row:hover .art-img-mood img{transform:scale(1.07)}
.art-decor-tag{position:absolute;top:18%;right:-8px;z-index:4;font-size:8.5px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:var(--muted);writing-mode:vertical-rl;opacity:0.6}
.art-row-orb{position:absolute;border-radius:50%;filter:blur(70px);pointer-events:none;z-index:0;animation:cardOrbPulse 9s ease-in-out infinite}
@keyframes cardOrbPulse{0%,100%{transform:scale(1)}50%{transform:scale(1.14)}}

.text-art-zone{
  background:linear-gradient(145deg,rgba(255,255,255,0.55),rgba(255,255,255,0.18));
  backdrop-filter:blur(28px) saturate(150%);
  border:1px solid rgba(255,255,255,0.65);border-top:1px solid rgba(255,255,255,0.85);border-left:1px solid rgba(255,255,255,0.8);
  border-radius:32px;padding:56px 50px;
  box-shadow:0 24px 60px rgba(13,31,26,0.04),inset 0 1px 2px rgba(255,255,255,0.9);
  transition:all 0.5s cubic-bezier(0.16,1,0.3,1);
  position:relative;overflow:hidden
}
.text-art-zone::before{content:'';position:absolute;inset:0;border-radius:inherit;border:1px solid rgba(255,255,255,0.7);pointer-events:none;z-index:0}
.text-art-zone>*{position:relative;z-index:1}
.chic-row:hover .text-art-zone{background:linear-gradient(145deg,rgba(255,255,255,0.72),rgba(255,255,255,0.28));border-color:rgba(255,255,255,0.9);box-shadow:0 36px 80px rgba(13,31,26,0.07),inset 0 1px 3px rgba(255,255,255,1)}

.chic-btn{display:inline-flex;align-items:center;gap:14px;font-size:10.5px;font-weight:700;letter-spacing:2.5px;text-transform:uppercase;color:var(--ink);margin-top:4px;transition:gap 0.35s}
.chic-btn .btn-line{width:38px;height:1.5px;background:var(--ink);border-radius:2px;transition:width 0.4s cubic-bezier(0.25,1,0.5,1);flex-shrink:0}
