}

/* ═══ TIKTOK DUAL CLIP ═══ */
.tiktok-dual-zone {
  overflow:visible !important;
  border-radius:0 !important;
  padding:0 !important;
  height:auto !important;
  position:relative
}
.tiktok-dual-wrap {
  position:relative;width:100%;
  display:flex;flex-direction:column;align-items:center;gap:20px
}
.tt-dual-label {
  font-size:8.5px;font-weight:700;letter-spacing:3px;text-transform:uppercase;
  color:#b07030;opacity:0.55;align-self:flex-end;padding-right:4px
}
.tt-phones-row {
  display:flex;gap:16px;align-items:flex-start;width:100%;justify-content:center
}
.tt-phone {
  position:relative;flex:1;max-width:calc(50% - 8px);aspect-ratio:10/17;
  border-radius:28px;overflow:hidden;
  border:4px solid rgba(255,255,255,0.92);
  box-shadow:0 0 0 1px rgba(252,190,120,0.3),0 24px 60px rgba(176,112,48,0.18),0 6px 18px rgba(0,0,0,0.1),inset 0 2px 3px rgba(255,255,255,0.8);
  background:#0d0d0d;transition:box-shadow 0.4s,transform 0.4s cubic-bezier(0.16,1,0.3,1)
}
.tt-phone:hover {
  box-shadow:0 0 0 1px rgba(252,190,120,0.45),0 32px 72px rgba(176,112,48,0.24),0 10px 24px rgba(0,0,0,0.14),inset 0 2px 3px rgba(255,255,255,0.9);
  transform:translateY(-4px) scale(1.01)
}
.tt-clip-badge {
  position:absolute;top:12px;left:50%;transform:translateX(-50%);z-index:12;
  background:rgba(0,0,0,0.42);backdrop-filter:blur(8px);
  border:1px solid rgba(255,255,255,0.18);border-radius:20px;
  padding:4px 12px;font-size:9px;font-weight:700;letter-spacing:1.5px;color:rgba(255,255,255,0.85);
