];
var WD=["Chủ Nhật","Thứ 2","Thứ 3","Thứ 4","Thứ 5","Thứ 6","Thứ 7"];
var BASE=new Date(2026,10,30),DAY=864e5,KEY="task_dg_done_v1";
var done={};try{done=JSON.parse(localStorage.getItem(KEY)||"{}")}catch(e){}
function save(){try{localStorage.setItem(KEY,JSON.stringify(done))}catch(e){}}
var DT="30/11,01/12,02/12,03/12,04/12,05/12,07/12,08/12,09/12,10/12,11/12,12/12,14/12,15/12,16/12,17/12,18/12,19/12,21/12,22/12,23/12,24/12,25/12,26/12,28/12,29/12,30/12,31/12,04/01,05/01,06/01,07/01,08/01,09/01,11/01,12/01".split(",");
var tasks=T.map(function(t,i){var d=Math.floor(i/2),p=DT[d].split("/"),dt=new Date(p[1]==="01"?2027:2026,+p[1]-1,+p[0]);return{id:i+1,day:d+1,dt:dt,dept:D[Math.floor(d/2)],star:FOUR.indexOf(i+1)>=0?4:5,text:t}});
var now=new Date(),t0=new Date(now.getFullYear(),now.getMonth(),now.getDate());
function diff(t){return Math.round((t.dt-t0)/DAY)}
function fd(dt){return String(dt.getDate()).padStart(2,"0")+"/"+String(dt.getMonth()+1).padStart(2,"0")+"/"+dt.getFullYear()}
function lbl(dt){return WD[dt.getDay()]+", "+fd(dt)}
var filter="all",pend=null,pto,db=null,uid=null;
function card(t){
  var d=done[t.id];
  return '<div id="c'+t.id+'" class="t'+(d?' done':'')+'"><div class="meta"><span class="chip">#'+t.id+'</span><span class="chip dk">'+t.dept+'</span><span class="sb s'+t.star+'">'+t.star+' ★ sao</span><span>🕕 Tối từ 18h</span></div><p class="tx">'+t.text+'</p><div class="row"><button class="cp" onclick="cp('+t.id+')">📋 Copy nội dung</button>'+'<button class="ck" onclick="tg('+t.id+')">'+(d?'✔ Đã đăng':'☐ Tick khi đã xong')+'</button>'+'</div></div>';
}
function vis(t){return filter==="all"||(filter==="done"?done[t.id]:!done[t.id])}
function list(a){var r=a.filter(vis);return r.length?r.map(card).join(""):'<div class="empty">Không có task</div>'}
function group(a,open){
  var m={};a.forEach(function(t){(m[t.day]=m[t.day]||[]).push(t)});
  return Object.keys(m).map(function(k,i){
    var g=m[k],c=g.filter(function(t){return done[t.id]}).length;
    return '<details data-d="'+k+'"'+(open&&i===0?' open':'')+'><summary><span class="sm"><b>'+lbl(g[0].dt)+'</b><span class="dp">'+g[0].dept+'</span><span class="sr">'+g.map(function(t){return '<span class="sb s'+t.star+'">'+t.star+' ★</span>'}).join('')+'</span></span><small>'+c+'/'+g.length+' xong</small></summary><div class="in">'+list(g)+'</div></details>';
  }).join("");
}
function render(){
  var op=[].map.call(document.querySelectorAll('details[open]'),function(e){return e.getAttribute('data-d')});
  var today=tasks.filter(function(t){return diff(t)===0});
  var late=tasks.filter(function(t){return diff(t)<0&&!done[t.id]});
  var up=tasks.filter(function(t){return diff(t)>0});
  var past=tasks.filter(function(t){return diff(t)<0&&done[t.id]});
  var h="";
  if(today.length){
    h='<div class="hero"><h2>🔥 Hôm nay – '+lbl(today[0].dt)+'</h2>'+list(today)+'</div>';
  }else if(up.length){
    var nx=up.filter(function(t){return t.day===up[0].day});
    h='<div class="hero wait"><h2>⏳ Hôm nay chưa có task. Sắp tới: '+lbl(nx[0].dt)+' (còn '+diff(nx[0])+' ngày)</h2>'+list(nx)+'</div>';
  }else h='<div class="hero wait"><h2>🎉 Đã hết lịch task</h2></div>';
  document.getElementById("hero").innerHTML=h;
  document.getElementById("late").innerHTML=late.length?'<div class="bad"><h2>⚠ Quá hạn chưa đăng ('+late.length+')</h2>'+list(late)+'</div>':"";
  var rest=today.length?up:up.filter(function(t){return t.day!==up[0].day});
  document.getElementById("up").innerHTML=rest.length?group(rest,false):'<div class="empty">Không còn task sắp tới</div>';
  document.getElementById("past").innerHTML=past.length?'<h2>Đã hoàn thành (ngày đã qua)</h2>'+group(past,false):"";
  op.forEach(function(k){var e=document.querySelector('details[data-d="'+k+'"]');if(e)e.open=true});
  var n=Object.keys(done).length;
  document.getElementById("pb").style.width=(n/tasks.length*100)+"%";
  document.getElementById("pt").textContent="Đã đăng "+n+"/"+tasks.length+" task ("+Math.round(n/tasks.length*100)+"%)";
}
function tg(id){
  if(done[id]){
    var o=done[id];delete done[id];
    if(db){db.doc("done/"+id).delete().catch(function(){done[id]=o;render();toast("Lỗi, chưa lưu được")})}else save();
    render();toast("Đã bỏ tick");return
  }
  done[id]={at:new Date().toISOString()};
  if(db){db.doc("done/"+id).set({at:done[id].at,by:uid||""}).catch(function(){delete done[id];render();toast("Lỗi, chưa lưu được")})}else save();
  render();toast("Đã ghi nhận ✔")
}
function toast(m){var e=document.getElementById("toast");e.textContent=m;e.classList.add("s");setTimeout(function(){e.classList.remove("s")},1400)}
function cp(id){
  var tx=tasks[id-1].text;
  if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(tx).then(function(){toast("Đã copy!")},fb)}else fb();
  function fb(){var a=document.createElement("textarea");a.value=tx;document.body.appendChild(a);a.select();try{document.execCommand("copy");toast("Đã copy!")}catch(e){toast("Không copy được")}a.remove()}
}
render();
(function(){var s='<tr><th>#</th><th>Khoa / Phòng ban</th><th>Ngày 1</th><th>Ngày 2</th></tr>';for(var i=0;i<18;i++){var a=tasks[i*4].dt,b=tasks[i*4+2].dt,nw=diff(tasks[i*4])===0||diff(tasks[i*4+2])===0;s+='<tr'+(nw?' class="now"':'')+'><td>'+(i+1)+'</td><td><b>'+D[i]+'</b></td><td>'+fd(a)+'<small>'+WD[a.getDay()]+'</small></td><td>'+fd(b)+'<small>'+WD[b.getDay()]+'</small></td></tr>'}document.getElementById("sch").innerHTML=s})();
document.getElementById("tabs").onclick=function(e){var t=e.target.getAttribute("data-t");if(!t)return;[].forEach.call(this.children,function(b){b.classList.toggle("on",b===e.target)});document.getElementById("pg").hidden=t!=="pg";document.getElementById("ptk").hidden=t!=="ptk";window.scrollTo(0,0)};
function exp(){claude.use("downloads").then(function(dl){if(!dl){toast("Không tải được");return}
var rows=[["STT","Ngày đăng","Khoa/Phòng","Số sao","Trạng thái","Thời gian tick"]];
tasks.forEach(function(t){var d=done[t.id];rows.push([t.id,fd(t.dt),t.dept,t.star,d?"Đã đăng":"Chưa đăng",d&&d.at?d.at:""])});
var csv="\ufeff"+rows.map(function(x){return x.map(function(c){return '"'+String(c).replace(/"/g,'""')+'"'}).join(",")}).join("\r\n");
return dl.save({filename:"trang-thai-danh-gia.csv",data:csv})}).catch(function(){toast("Không tải được")})}
try{window.claude&&claude.use("user").then(function(u){return u&&u.canEdit()}).then(function(v){if(v)document.getElementById("adm").hidden=false}).catch(function(){})}catch(e){}
try{window.claude&&claude.use("db").then(function(d){if(!d)return;db=d;return claude.use("user").then(function(u){return u&&u.id?u.id():null}).catch(function(){return null}).then(function(id){uid=id;db.collection("done").onSnapshot(function(s){var x={};s.docs.forEach(function(q){x[q.id]=q.data()||{at:""}});done=x;render()},function(){})})}).catch(function(){})}catch(e){}
</script>
</body>
</html>
